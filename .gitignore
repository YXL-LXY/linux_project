data/
*.mqd
*.db

# Keep the SQLite fixtures used by the tests.
!tests/data/
!tests/data/**

# ---------------------------------------------------------------------------
# Logs and temporary files
# ---------------------------------------------------------------------------
*.log
*.tmp
*.bak
*.swp
core
core.*

